# Praman — environment template. Copy to .env and fill in. NEVER commit .env.

# --- Which model answers the semantic question ---
#   anthropic — claude-opus-5. What the published metrics were measured on.
#   gemini    — free-tier Gemini Flash, rotated across a pool of keys.
# Metrics DO NOT transfer between providers. Re-run the eval and label the
# result with the model that produced it.
PRAMAN_PROVIDER=gemini

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Google Gemini (free tier) ---
# A comma-separated pool. Each key is a separate Google account/project, since
# quota is enforced per project. The ring rotates across them, paces calls to
# the pool's aggregate RPM, and retires a key that has spent its day.
#   3 keys comfortably covers a full 600-case evaluation in ~10 minutes.
#   1 key still completes it, just slower (~50 minutes).
GEMINI_API_KEYS=

# Requests per minute to assume PER KEY. The pool is paced at this times the
# number of keys. Lower it if you see sustained 429s; raise it if Google's
# limits are more generous than this.
PRAMAN_GEMINI_RPM=10

# gemini-2.5-flash / gemini-3-flash are the free-tier workhorses.
# Avoid the Pro models on the free tier: ~50 requests/day runs out immediately.
PRAMAN_GEMINI_MODEL=gemini-2.5-flash

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Base64 of "<key_id>:<key_secret>" — used by the Razorpay MCP server.
RAZORPAY_BASE64_TOKEN=

# Full HTTP Authorization header for the Razorpay remote MCP server:
#   Basic <RAZORPAY_BASE64_TOKEN>
AUTH_HEADER=

# --- Praman ---
# Which payment gateway implementation the ledger books against.
#   mock     — Razorpay-shaped in-process gateway. Default. No network.
#   razorpay — live Razorpay test-mode REST API. Needs api.razorpay.com reachable.
PRAMAN_PG=mock

# Model used by the mandate compiler and the intent adjudicator.
PRAMAN_MODEL=claude-opus-5
