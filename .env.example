# Praman — environment template. Copy to .env and fill in. NEVER commit .env.

# --- Which model answers the semantic question ---
#   groq      — free-tier Groq. The current default: its free tier survives a
#               100-case run, which Gemini's did not.
#   anthropic — claude-opus-5. What the earlier published metrics were on.
#   gemini    — free-tier Gemini Flash, rotated across a pool of keys.
# Metrics DO NOT transfer between providers. Re-run the eval and label the
# result with the model that produced it.
PRAMAN_PROVIDER=groq

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Google Gemini (free tier) ---
# A comma-separated pool. Each key is a separate Google account/project, since
# quota is enforced per project. The ring rotates across them, paces calls to
# the pool's aggregate RPM, and retires a key that has spent its day.
#   3 keys comfortably covers a full 600-case evaluation in ~10 minutes.
#   1 key still completes it, just slower (~50 minutes).
#
# AI Studio now issues Auth keys, which start AQ.Ab, in place of the older
# Standard keys starting AIza. Both are accepted here -- the ring never looks at
# the format -- but an older google-genai rejects AQ. keys outright with
# "API key not valid", which reads like a revoked credential and is not one.
# requirements.txt pins the floor at 2.24 for that reason. Confirm with
# tools/check_keys.py before spending a run.
#
# ONE LINE, comma separated. A .env value ends at the newline, so a JSON array
# split over several lines hands the process the single character "[" and the
# keys never arrive at all -- which then surfaces as "API key not valid",
# pointing at the console instead of at this file. A bracketed list on one line
# is accepted; a line break anywhere inside the value is not.
#   GEMINI_API_KEYS="AQ.Ab...one,AQ.Ab...two,AQ.Ab...three"
GEMINI_API_KEYS=

# Requests per minute to assume PER KEY. The pool is paced at this times the
# number of keys. Lower it if you see sustained 429s; raise it if Google's
# limits are more generous than this.
PRAMAN_GEMINI_RPM=10

# gemini-3-flash-preview is the HEADLINE MODEL -- the one the published metrics
# are measured on, and the one to re-run after any prompt change. It beat
# claude-opus-5 on accuracy, injection resistance and step-up recall, and unlike
# opus it can still be re-run, which for a project whose claim is
# reproducibility is not a tiebreaker but the whole argument.
# Avoid the Pro models on the free tier: ~50 requests/day runs out immediately.
PRAMAN_GEMINI_MODEL=gemini-3-flash-preview

# --- Groq (free tier) ---
# Comma separated, ONE line, same as the Gemini pool. GROQ_API_KEY is read too
# and may hold a list, since that is what people write.
#
# Groq meters per ORGANISATION, not per key: three keys from one account share
# one 30 requests/minute allowance, so a pool is resilience against a bad key
# rather than extra throughput. PRAMAN_GROQ_RPM is therefore the POOL rate, not
# the per-key rate -- raise it to 30 x (number of separate accounts) if the keys
# really are from different ones.
GROQ_API_KEYS=
PRAMAN_GROQ_RPM=30

# openai/gpt-oss-120b: strong enough for a judgment task under adversarial
# input, and 200K tokens/day on the free tier against 100K for
# llama-3.3-70b-versatile, which a 100-case run would exhaust.
PRAMAN_GROQ_MODEL=openai/gpt-oss-120b

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# UNUSED. Both of these are for Razorpay's own hosted MCP server, which Praman
# does not call: praman/pg/razorpay_pg.py goes to the REST API directly, and
# tools/razorpay_check.py proves that path against live test mode.
#
# Praman is itself an MCP server -- see praman/mcp/server.py -- but that is the
# other end of the system: a buyer agent proposing purchases through the gate.
# The two are unrelated, and leaving these filled in would suggest a dependency
# that is not there.
#
# RAZORPAY_BASE64_TOKEN   base64 of "<key_id>:<key_secret>"
# AUTH_HEADER             "Basic <RAZORPAY_BASE64_TOKEN>"
RAZORPAY_BASE64_TOKEN=
AUTH_HEADER=

# --- Praman ---
# Which payment gateway implementation the ledger books against.
#   mock     — Razorpay-shaped in-process gateway. Default. No network.
#   razorpay — live Razorpay test-mode REST API. Needs api.razorpay.com reachable.
PRAMAN_PG=mock

# Model used by the mandate compiler and the intent adjudicator.
PRAMAN_MODEL=claude-opus-5
